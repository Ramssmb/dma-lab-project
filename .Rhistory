library(MASS)
library(dplyr)
library(randomForest)
library(ggplot2)
library(tidyr)
library(vip)
# Run installation only once
install.packages(c("MASS", "dplyr", "randomForest",
"ggplot2", "tidyr", "vip"))
n_samples <- 10000
n_informative <- 5
n_redundant <- 15
n_irrelevant <- 180
n_features <- n_informative + n_redundant + n_irrelevant
irrelevant_features <- matrix(
rnorm(n_samples * n_irrelevant),
ncol = n_irrelevant
)
colnames(irrelevant_features) <- paste0(
"noise_", 1:n_irrelevant
)
informative_features <- matrix(
rnorm(n_samples * n_informative),
ncol = n_informative
)
colnames(informative_features) <- paste0("info_", 1:5)
# Generate target variable
logit_prob <- 0.5 * informative_features[,1] -
1.2 * informative_features[,2] +
0.8 * (informative_features[,3]^2) -
0.6 * informative_features[,4] *
informative_features[,5] +
0.3 * sin(informative_features[,5])
prob <- 1 / (1 + exp(-logit_prob))
target <- rbinom(n_samples, 1, prob)
cor_matrix <- matrix(0.8, nrow = 4, ncol = 4)
diag(cor_matrix) <- 1
redundant_features_list <- list()
for (i in 1:n_informative) {
correlated_block <- mvrnorm(
n = n_samples,
mu = rep(0, 4),
Sigma = cor_matrix
)
redundant_features_list[[i]] <- correlated_block[, 2:4]
}
cor_matrix <- matrix(0.8, nrow = 4, ncol = 4)
diag(cor_matrix) <- 1
redundant_features_list <- list()
for (i in 1:n_informative) {
correlated_block <- mvrnorm(
n = n_samples,
mu = rep(0, 4),
Sigma = cor_matrix
)
redundant_features_list[[i]] <- correlated_block[, 2:4]
}
irrelevant_features <- matrix(
rnorm(n_samples * n_irrelevant),
ncol = n_irrelevant
)
colnames(irrelevant_features) <- paste0(
"noise_", 1:n_irrelevant
)
final_df <- data.frame(
target,
informative_features,
redundant_features,
irrelevant_features
)
predictors <- final_df[, -1]
explained_variance <- (pca_result$sdev^2) /
sum(pca_result$sdev^2)
loadings <- pca_result$rotation
ggplot(
head(gini_importance, 20),
aes(
x = reorder(Feature, MeanDecreaseGini),
y = MeanDecreaseGini
)
) +
geom_bar(stat = "identity", fill = "skyblue") +
coord_flip() +
labs(
title = "Top 20 Features by Gini Importance",
x = "Features",
y = "Mean Decrease in Gini"
) +
theme_minimal()
