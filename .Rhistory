# Step 2: Dataset Parameters
set.seed(42)
n_samples <- 10000
n_informative <- 5
n_redundant <- 15
n_irrelevant <- 180
n_features <- n_informative +
n_redundant +
n_irrelevant
# Generate informative features
informative_features <- matrix(
rnorm(n_samples * n_informative),
ncol = n_informative
)
colnames(informative_features) <- paste0(
"info_", 1:n_informative
)
# Display results
print(dim(informative_features))
print(head(informative_features))
# Step 3: Generate Target Variable
logit_prob <- 0.5 * informative_features[,1] -
1.2 * informative_features[,2] +
0.8 * (informative_features[,3]^2) -
0.6 * informative_features[,4] *
informative_features[,5] +
0.3 * sin(informative_features[,5])
# Calculate probability
prob <- 1 / (1 + exp(-logit_prob))
# Generate target
target <- rbinom(n_samples, 1, prob)
# Display output
print(head(target))
# Count target values
print(table(target))
# Step 4: Generate Redundant Features
cor_matrix <- matrix(0.8, nrow = 4, ncol = 4)
diag(cor_matrix) <- 1
redundant_features_list <- list()
for (i in 1:n_informative) {
correlated_block <- mvrnorm(
n = n_samples,
mu = rep(0, 4),
Sigma = cor_matrix
)
redundant_features_list[[i]] <- correlated_block[, 2:4]
}
library(MASS)
# Check function
print("MASS package loaded successfully")
cor_matrix <- matrix(0.8, nrow = 4, ncol = 4)
diag(cor_matrix) <- 1
redundant_features_list <- list()
for (i in 1:n_informative) {
correlated_block <- MASS::mvrnorm(
n = n_samples,
mu = rep(0, 4),
Sigma = cor_matrix
)
redundant_features_list[[i]] <- correlated_block[, 2:4]
}
redundant_features <- do.call(
cbind,
redundant_features_list
)
colnames(redundant_features) <- paste0(
"redun_", 1:n_redundant
)
print(dim(redundant_features))
print(head(redundant_features))
# Step 5: Generate Irrelevant Features
irrelevant_features <- matrix(
rnorm(n_samples * n_irrelevant),
ncol = n_irrelevant
)
# Assign column names
colnames(irrelevant_features) <- paste0(
"noise_", 1:n_irrelevant
)
# Display results
